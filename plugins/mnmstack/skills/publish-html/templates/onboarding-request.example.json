{
  "version": 1,
  "cloud": "AzureCloud",
  "tenantId": "<approved-tenant-guid>",
  "subscriptionId": "<approved-subscription-guid>",
  "location": "<selected-azure-region>",
  "resourceGroup": { "mode": "create", "name": "<selected-resource-group-name>" },
  "plan": { "mode": "create", "name": "<selected-linux-plan-name>", "sku": "B1" },
  "identity": { "mode": "create", "name": "<selected-managed-identity-name>" },
  "application": { "mode": "reuse", "name": "<selected-registration-display-name>", "id": "<registration-object-guid-not-client-guid>" },
  "site": { "mode": "create", "name": "<selected-site-name>" },
  "readerGroups": [
    { "mode": "reuse", "name": "<selected-security-group-name>", "id": "<approved-security-group-object-guid>" }
  ],
  "managerObjectIds": ["<approved-manager-user-object-guid>"],
  "managerGroupIds": [],
  "allowedClientIds": ["<approved-delegated-client-application-guid>"],
  "diagnostics": { "mode": "off" }
}
